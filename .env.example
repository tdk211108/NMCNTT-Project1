# Admin & Session Security (server-only)
# Generate hash via: npm run admin:hash -- "<your-password>"
ADMIN_PASSWORD=scrypt:32768:8:1:<salt>:<hash>
# Generate 48 random bytes base64 via: openssl rand -base64 48
AUTH_SECRET=replace_with_at_least_32_random_bytes_base64

# OAuth2 Social Login (server-only, optional for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

